        {
            "id": "babylonjs-tiaratumgames-tools",
            "score": 10,
            "title": "Tiaratum Games Tools for BabylonJS",
            "lastUpdate": 2026,
            "status": "code",
            "description": [
                "babylonjs-tiaratumgames-tools is a collection of tools and utilities for BabylonJS.",
                "AnimationFactory are helpers to animation numbers, Vector3 and Color3.",
                "Intersection provides methods to compute intersection between Ray, Box, Sphere, Mesh, Capsule and Wire.",
                "MeshBuilder extends BabylonJS MeshBuilder methods with BeveledBox, BeveledCylinder, 9Sliced Quad, Disc, DiscSlice and SphereCut.",
                "Number, Vector3 and Quaternion are extended with useful computation and generation methods.",
                "VertexDataUtils provides methods to manipulate VertexData, like merging, cloning, scaling, translatin, rotating, coloring and mirroring."
            ],
            "tags": ["npm", "typescript", "babylon.js"],
            "tiaratumGames": true,
